# Generated by porting/scripts/gen-fedora-packaging.py (regolith-powerd). Do not edit by hand.
# COPR SCM "make_srpm": make -f .copr/Makefile srpm outdir=<dir> [spec=<spec>]
# Untagged commits get a snapshot release (<release>.<commit date>git<sha>) so every build upgrades;
# a commit tagged fedora/v* (testing/stable) keeps the spec's release.
spec ?= fedora/regolith-powerd.spec
outdir ?= $(CURDIR)/_srpm

.PHONY: srpm
srpm:
	command -v rpmbuild >/dev/null && command -v git >/dev/null && command -v cargo >/dev/null || dnf -y install rpm-build git-core tar gzip cargo
	git config --global --add safe.directory '*'
	# offline RPM build: vendor the crates and point cargo at them
	mkdir -p .cargo && cargo vendor --locked --versioned-dirs vendor > .cargo/vendor-config.toml
	cat .cargo/vendor-config.toml >> .cargo/config.toml
	mkdir -p $(outdir)
	set -e; name=$$(rpmspec -q --srpm --qf '%{name}' $(spec)); ver=$$(rpmspec -q --srpm --qf '%{version}' $(spec)); \
	rel=$$(sed -n 's/^Release:[[:space:]]*\([^%]*\).*/\1/p' $(spec)); \
	if ! git describe --exact-match --tags --match 'fedora/v*' >/dev/null 2>&1; then \
	  rel=$$rel.$$(TZ=UTC git log -1 --format=%cd --date=format-local:%Y%m%d.%H%M%S)git$$(git rev-parse --short=7 HEAD); fi; \
	sed "s/^Release:.*/Release:        $$rel%{?dist}/" $(spec) > $(outdir)/$$name.spec; \
	tar --exclude=.git --exclude=./_srpm --exclude=./_fedora_build --exclude=./_fedora_stage --exclude=./.fedora-patched \
	    --exclude=./target --transform "s|^\.|$$name-$$ver|" -czf $(outdir)/$$name-$$ver.tar.gz .; \
	rpmbuild -bs --define "_sourcedir $(outdir)" --define "_srcrpmdir $(outdir)" $(outdir)/$$name.spec
