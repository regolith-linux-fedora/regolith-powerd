# Generated by porting/scripts/gen-fedora-packaging.py from regolith-powerd/debian/. Do not edit by hand.
Name:           regolith-powerd
Version:        0.10.0
Release:        1%{?dist}
Summary:        Daemon for using swayidle
License:        GPL-3.0-or-later
URL:            https://github.com/regolith-linux/regolith-powerd
Source0:        %{name}-%{version}.tar.gz

# Rust binaries carry no debug-friendly build-id split yet; keep debuginfo off for the POC
%global debug_package %{nil}
BuildRequires:  make
BuildRequires:  cargo
BuildRequires:  rust
BuildRequires:  systemd-rpm-macros
BuildRequires:  pkgconf-pkg-config
BuildRequires:  pkgconfig(glib-2.0)
BuildRequires:  dbus-daemon
%{?systemd_requires}

Requires:       swayidle
Requires:       (sway or sway-regolith)
Requires:       light
Requires:       bc
Requires:       gnome-session
Requires:       trawldb
Requires:       systemd
Requires:       playerctl
Requires:       gsettings-desktop-schemas
Recommends:     gvfs
Recommends:     gcr

%description
Daemon for using swayidle

%prep
%autosetup -n %{name}-%{version}

%build
%set_build_flags
%make_build -f fedora/Makefile build

%install
%make_install -f fedora/Makefile PREFIX=%{_prefix} LIBDIR=%{_libdir} SYSCONFDIR=%{_sysconfdir}
# single-binary compiled package: own everything the build installed
(cd %{buildroot} && find . \( -type f -o -type l \) | sed 's|^\.||' \
   | sed -E 's|^(/usr/lib/python3[^/]*/site-packages/[^/]+)/.*|\1|; s|^(/usr/share/man/.*)$|\1*|' \
   | sort -u | sed -E 's|^(/etc/.*)$|%config(noreplace) \1|') > regolith-powerd.files

%post -n regolith-powerd
%systemd_user_post regolith-init-powerd.service

%preun -n regolith-powerd
%systemd_user_preun regolith-init-powerd.service

%files -f regolith-powerd.files

